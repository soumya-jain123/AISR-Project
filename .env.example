# AISR Multiplayer Backend Environment Configuration

# Server Bind Settings
MP_HOST=127.0.0.1
MP_PORT=8000

# Simulation Mode: 'mock' (headless development) or 'coppelia' (live simulator)
MP_SIM_MODE=mock

# Logging Level: DEBUG, INFO, WARNING, ERROR
MP_LOG_LEVEL=INFO

# CORS Allowed Origins (comma-separated, e.g. http://localhost:5173,http://localhost:3000)
MP_CORS_ORIGINS=*

# CoppeliaSim Remote API Connection (when MP_SIM_MODE=coppelia)
COPPELIA_HOST=127.0.0.1
COPPELIA_PORT=23004

# Room Limits
MP_MAX_PLAYERS_PER_ROOM=4
